# Copy this file to .streamlit/secrets.toml and fill in your keys.
# In Streamlit Community Cloud, add these under App Settings → Secrets.

# LLM provider — set this to use Groq instead of local Ollama.
# Get a free key at https://console.groq.com
GROQ_API_KEY = ""

# Optional: override which Groq model to use (default: llama-3.1-8b-instant)
# GROQ_MODEL = "llama-3.1-8b-instant"
